#include <iostream>
using namespace std;

void doubleSelectionSort(int nums[], int size) {
    int start = 0, end = size - 1;

    while (start < end) {
        int minPos = start;
        int maxPos = start;

        for (int i = start; i <= end; i++) {
            if (nums[i] < nums[minPos]) minPos = i;
            if (nums[i] > nums[maxPos]) maxPos = i;
        }

        swap(nums[start], nums[minPos]);

        if (maxPos == start) maxPos = minPos;

        swap(nums[end], nums[maxPos]);

        start++;
        end--;
    }
}

int main() {
    int n;
    cin >> n;
    int nums[n];

    for (int i = 0; i < n; i++) cin >> nums[i];

    doubleSelectionSort(nums, n);

    for (int i = 0; i < n; i++) cout << nums[i] << " ";
}
